{
  "name": "@imad-store/backend",
  "version": "0.0.1",
  "description": "Imad Store REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "seed:admin": "ts-node scripts/seed-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "predev": "npm --prefix ../packages/shared run build"
  },
  "dependencies": {
    "@imad-store/shared": "*",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^178.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.1.7",
    "resend": "^3.2.0",
    "stripe": "^15.7.0",
    "zod": "^4.6.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "tsx": "^4.20.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
