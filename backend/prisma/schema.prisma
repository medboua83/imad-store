// Imad Store — Prisma Schema for MongoDB Atlas (free tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────
// MongoDB supports Prisma enums natively

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  STRIPE
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─── Address ────────────────────────────────────────────────────────────────

model Address {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  userId     String? @db.ObjectId
  user       User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fullName   String
  phone      String
  street     String
  city       String
  region     String
  postalCode String?
  isDefault  Boolean @default(false)

  orders Order[]

  @@map("addresses")
}

model AdminNotification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String   // "new_order" | "low_stock" | etc.
  title     String
  message   String
  orderId   String?  @db.ObjectId
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("admin_notifications")
}

// ─── Category ───────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  slug     String    @unique
  nameFr   String
  nameAr   String
  nameEn   String
  image    String?
  products Product[]

  @@map("categories")
}

// ─── Product ────────────────────────────────────────────────────────────────

model Product {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  slug           String           @unique
  nameFr         String
  nameAr         String
  nameEn         String
  descriptionFr  String
  descriptionAr  String
  descriptionEn  String
  price          Float
  compareAtPrice Float?
  images         String[]         // Native array — no JSON hack needed!
  status         ProductStatus    @default(DRAFT)
  categoryId     String           @db.ObjectId
  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color       String
  colorNameFr String
  colorNameAr String
  colorNameEn String
  size        String?
  stock       Int      @default(0)
  sku         String   @unique

  orderItems OrderItem[]

  @@map("product_variants")
}

// ─── Order ──────────────────────────────────────────────────────────────────

model Order {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  userId                String?       @db.ObjectId
  user                  User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Guest customer info (denormalized so admins can see the order without joining Address)
  customerName          String?
  customerPhone         String?
  customerEmail         String?
  addressId             String?       @db.ObjectId
  address               Address?      @relation(fields: [addressId], references: [id])
  // Delivery address snapshot (for guest orders where no Address row is required)
  fullName              String?
  phone                 String?
  street                String?
  city                  String?
  region                String?
  postalCode            String?
  status                OrderStatus   @default(PENDING)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  totalAmount           Float
  shippingCost          Float         @default(0)
  notes                 String?
  items                 OrderItem[]
  events                OrderEvent[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String         @db.ObjectId
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String         @db.ObjectId
  product   Product        @relation(fields: [productId], references: [id])
  variantId String         @db.ObjectId
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Float

  @@map("order_items")
}

// ─── Order Event (lightweight admin notification log) ────────────────────────
model OrderEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // "created" | "status_changed" | "payment_received" | etc.
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("order_events")
}

// ─── Store Settings ─────────────────────────────────────────────────────────

model StoreSettings {
  id              String  @id @map("_id")
  whatsappPhone   String  @default("212XXXXXXXXX")
  shippingCost    Float   @default(30)
  freeShippingMin Float   @default(500)
  codEnabled      Boolean @default(true)
  webhookEnabled  Boolean @default(false)
  webhookUrl      String?

  @@map("store_settings")
}

// ─── Telegram Customer (auto-reply lookup) ───────────────────────────────────
// When a customer starts a chat with the bot, we record their phone → chatId
// so the bridge can DM them order acknowledgments automatically.
model TelegramCustomer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  chatId    String
  firstName String?
  username  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_customers")
}

model WebhookDelivery {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  eventKey      String   @unique
  orderId       String   @db.ObjectId
  payload       Json
  targetUrl     String
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}
