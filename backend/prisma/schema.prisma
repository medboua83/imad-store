// Imad Store — PostgreSQL. Legacy 24-hex commerce identifiers remain stable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────
// Database constraints are installed by versioned SQL migrations.

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  STRIPE
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole @default(CUSTOMER)
  permissions  String[] @default([])
  isActive     Boolean  @default(true)
  authVersion  Int      @default(0)
  mustSetPassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]

  @@map("users")
}

model PasswordReset {
  tokenHash String @id
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  authVersion Int
  expiresAt DateTime
  requestedAt DateTime @default(now())
  mailCiphertext String?
  mailState String @default("PENDING")
  claimedAt DateTime?
  kind String @default("RESET")
  @@map("password_resets")
}

model GmailConfig {
  id String @id @default("gmail")
  enabled Boolean @default(false)
  gmailUser String
  port Int @default(465)
  passwordCiphertext String?
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  @@map("gmail_config")
}

model AccessEvent {
  id String @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  actorId String
  targetId String?
  action String
  createdAt DateTime @default(now())
  @@map("access_events")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─── Address ────────────────────────────────────────────────────────────────

model Address {
  id         String  @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fullName   String
  phone      String
  street     String
  city       String
  region     String
  postalCode String?
  isDefault  Boolean @default(false)

  orders Order[]

  @@map("addresses")
}

model AdminNotification {
  id        String   @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  type      String   // "new_order" | "low_stock" | etc.
  title     String
  message   String
  orderId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("admin_notifications")
}

// ─── Category ───────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  slug     String    @unique
  nameFr   String
  nameAr   String
  nameEn   String
  image    String?
  products Product[]

  @@map("categories")
}

// ─── Product ────────────────────────────────────────────────────────────────

model Product {
  id             String           @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  slug           String           @unique
  nameFr         String
  nameAr         String
  nameEn         String
  descriptionFr  String
  descriptionAr  String
  descriptionEn  String
  price          Float
  compareAtPrice Float?
  quantityDiscounts Json?
  recommendationSettings Json?
  productInformation Json?
  freeShipping   Boolean @default(false)
  images         String[]         // Native array — no JSON hack needed!
  colorPhotos    Json?
  status         ProductStatus    @default(DRAFT)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color       String
  colorNameFr String
  colorNameAr String
  colorNameEn String
  size        String?
  stock       Int      @default(0)
  sku         String   @unique

  orderItems OrderItem[]

  @@map("product_variants")
}

// ─── Order ──────────────────────────────────────────────────────────────────

model Order {
  confirmationMethod    String?
  confirmedAt           DateTime?
  deletedAt             DateTime?
  idempotencyKey        String?       @unique
  orderServiceRequested Boolean?
  orderServicePolicyVersion String?
  orderServiceRequestedAt DateTime?
  aiServiceConsent      Boolean?
  aiServiceConsentVersion String?
  aiServiceConsentAt    DateTime?
  inventoryReserved     Boolean?
  requestFingerprint    String?
  id                    String        @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // Guest customer info (denormalized so admins can see the order without joining Address)
  customerName          String?
  customerPhone         String?
  customerEmail         String?
  addressId             String?
  address               Address?      @relation(fields: [addressId], references: [id])
  // Delivery address snapshot (for guest orders where no Address row is required)
  fullName              String?
  phone                 String?
  street                String?
  city                  String?
  region                String?
  postalCode            String?
  status                OrderStatus   @default(PENDING)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  totalAmount           Float
  shippingCost          Float         @default(0)
  notes                 String?
  items                 OrderItem[]
  events                OrderEvent[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Float

  @@map("order_items")
}

// ─── Order Event (lightweight admin notification log) ────────────────────────
model OrderEvent {
  id        String   @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // "created" | "status_changed" | "payment_received" | etc.
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("order_events")
}

// ─── Store Settings ─────────────────────────────────────────────────────────

model StoreSettings {
  id              String  @id
  whatsappPhone   String  @default("212XXXXXXXXX")
  whatsappUrl     String?
  instagramUrl    String?
  facebookUrl     String?
  tiktokUrl       String?
  shippingCost    Float   @default(30)
  freeShippingMin Float   @default(500)
  deliveryMaxDays Int?
  returnWindowDays Int?
  returnFeePayer String?
  codEnabled      Boolean @default(true)
  directSiteConfirmation Boolean @default(false)
  metaPixelEnabled Boolean @default(false)
  metaPixelId      String?
  metaPixelMadPerUsd Float?
  metaDomainVerification String?

  @@map("store_settings")
}

// ─── Telegram Customer (auto-reply lookup) ───────────────────────────────────
// When a customer starts a chat with the bot, we record their phone → chatId
// so the bridge can DM them order acknowledgments automatically.
model TelegramCustomer {
  id        String   @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  phone     String   @unique
  chatId    String
  verifiedAt DateTime?
  firstName String?
  username  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_customers")
}

// Durable CRM delivery tracking; one row per source order.
model DeskcommOutbox {
  id            String   @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  orderId       String   @unique
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt      DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@map("deskcomm_outbox")
}

model DeskcommIntegration {
  id                String   @id
  enabled           Boolean  @default(false)
  orderAssistanceEnabled Boolean?
  webhookCiphertext String?
  signingCiphertext String?
  updatedAt         DateTime @updatedAt
  @@map("deskcomm_integrations")
}

// Explicit draft/publication history; public reads never expose a draft.
model SiteContent {
  id String @id
  revision Int @default(0)
  draft Json
  published Json
  previous Json?
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  @@map("site_content")
}

// One immutable receipt per signed CRM delivery; no customer payload retained.
model DeskcommStatusReceipt {
  id          String   @id
  orderId     String
  leadId      String
  fingerprint String
  changed     Boolean
  createdAt   DateTime @default(now())
  @@map("deskcomm_status_receipts")
}

// Immutable deployment identity. Each company has its own database and secrets.
model StoreInstallation {
  id String @id
  storeId String
  initialized Boolean @default(false)
  companyId String
  createdAt DateTime @default(now())
  @@map("store_installation")
}

// Encrypted per-installation callback configuration; never returned with its secret.
model DeskcommConnection {
  id String @id
  ciphertext String
  updatedAt DateTime @updatedAt
  @@map("deskcomm_connection")
}

// Opt-in carrier configuration. Credentials are encrypted; activation never backfills orders.
model OlivraisonIntegration {
  id String @id
  enabled Boolean @default(false)
  credentials String?
  pickupAddress Json?
  cityMapping Json?
  autoPickup Boolean @default(true)
  activatedAt DateTime?
  nextRequestAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("olivraison_integration")
}

// The source order ID is the database primary key: duplicate enqueue is impossible.
model OlivraisonShipment {
  id String @id
  trackingId String?
  carrierStatus String?
  lastSyncedAt DateTime?
  state String @default("QUEUED")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  lockedUntil DateTime @default(now())
  lastError String?
  stickerUrl String?
  slipUrl String?
  pickupAttempted Boolean @default(false)
  approvedAt DateTime?
  approvedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("olivraison_shipments")
}

// First-party analytics; ephemeral and scoped to one installation, without customer PII.
model StoreAnalytics {
  id String @id
  scope String
  session String
  kind String
  page String?
  test Boolean
  at DateTime
  productId String?
  productName String?
  stage String?
  stageRank Int?
  expiresAt DateTime
  @@index([scope, test, at], map: "scope_period")
  @@index([scope, session, kind], map: "scope_session")
  @@index([expiresAt], map: "analytics_retention")
  @@map("store_analytics")
}

// Immutable in-store receipts; use the shared variant stock, never the shipping order pipeline.
model PosSale {
  id String @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  idempotencyKey String @unique
  requestFingerprint String
  cashierId String
  cashierName String
  paymentMethod String
  totalCents Int
  savingsCents Int
  receivedCents Int
  changeCents Int
  createdAt DateTime @default(now())
  items PosSaleItem[]
  @@index([cashierId, createdAt])
  @@index([createdAt])
  @@map("pos_sales")
}

// Snapshot identifiers intentionally have no mutable catalogue relation: receipts survive edits.
model PosSaleItem {
  id String @id @default(dbgenerated("substr(replace(gen_random_uuid()::text, '-', ''), 1, 24)"))
  saleId String
  sale PosSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  position Int
  productId String
  variantId String
  sku String
  nameFr String
  nameAr String
  colorFr String
  colorAr String
  size String?
  quantity Int
  unitPriceCents Int
  totalCents Int
  @@unique([saleId, position])
  @@map("pos_sale_items")
}
