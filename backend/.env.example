# ─── Server ───────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─── Admin Dashboard Auth ─────────────────────
ADMIN_EMAIL="admin@imad-store.ma"
ADMIN_PASSWORD="Admin123456!"

# ─── Database (MongoDB Atlas) ─────────────────
DATABASE_URL="mongodb+srv://user:password@cluster0.mongodb.net/imad_store?retryWrites=true&w=majority"

# ─── Auth ─────────────────────────────────────
JWT_SECRET=your-super-secret-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Telegram Bot (Order Notifications) ───────
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# ─── Google Sheets API (Order Logging) ────────
GOOGLE_SHEETS_SPREADSHEET_ID="your_spreadsheet_id"
GOOGLE_SHEET_ID="your_sheet_id"
GOOGLE_SPREADSHEET_ID="your_spreadsheet_id"
GOOGLE_CLIENT_EMAIL="your_client_email@gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Required to accept Telegram webhook updates; configure the same secret in setWebhook.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
# Optional persistent product image storage (back up alongside the database).
# UPLOAD_DIR=/absolute/path/to/product-images
# Demo fixtures: use npm run seed:demo only on an isolated imad_ci test database.
