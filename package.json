{
  "name": "imad-store",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "npx turbo run dev",
    "build": "node scripts/prepare-hosted-build.cjs && npm --prefix packages/shared run build && npm --prefix backend run prisma:generate && npm --prefix backend run build && npm --prefix apps/web run build && node scripts/copy-standalone-assets.js",
    "start": "node server.js",
    "lint": "npx turbo run lint",
    "test": "npm run test:integration",
    "test:hosted": "node scripts/test-hosted-runtime.cjs",
    "test:integration": "npm --prefix packages/shared run build && node scripts/run-integration-tests.cjs",
    "check": "npm --prefix packages/shared run build && npm --prefix backend run build && npm --prefix apps/web run lint && npm run build",
    "predev": "npm --prefix packages/shared run build",
    "store:create": "node scripts/create-company-store.cjs",
    "store:admin": "node --import tsx backend/scripts/provision-company-admin.ts",
    "store:run": "node scripts/run-company-store.cjs",
    "test:installer": "node --test tests/store-installer.test.cjs",
    "store:bundle": "node scripts/bundle-company-store.cjs"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3",
    "tailwindcss": "^4.3.3",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.5.0",
    "tsx": "^4.20.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3"
  },
  "dependencies": {
    "express-rate-limit": "^8.7.0",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.50.0",
    "react-is": "19.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.5",
    "dotenv": "16.6.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7"
  }
}
